---
import BaseLayout from "../layouts/BaseLayout.astro";
import TimeLineElement from "../components/cv/TimeLine.astro";
---

<BaseLayout title="Resume" sideBarActiveItemID="cv">
  <div class="mb-5">
    <div class="text-3xl w-full font-bold">Profile</div>
  </div>

  <div class="mb-10 text-justify">
    PhD student in computational biology, researching the conformational dynamics of intrinsically disordered regions (IDRs) in proteins, combining deep learning modeling and molecular dynamics simulations.
    Proficient in Python+R / GROMACS+Amber / PyTorch+Sklearn, with research interests in transcription factors related to 3D genomics. Also do some multi-omics data analysis about cancer.
  </div>

  <div class="mb-5">
    <div class="text-3xl w-full font-bold">Education</div>
  </div>

  <div class="time-line-container grid gap-4 mb-10">
    <TimeLineElement
      title="PhD · Computational Biology"
      subtitle="2024 - Present · Shanghai Jiao Tong University, Shanghai, China"
    />
    <TimeLineElement
      title="Bachelor · Bioinformatics"
      subtitle="2020 - 2024 · Southeast University, Nanjing, China"
    />
  </div>

  <div class="mb-5">
    <div class="text-3xl w-full font-bold">Experience</div>
  </div>

  <div class="time-line-container grid gap-4 mb-10">
    <TimeLineElement
      title="Summer Intern, BGI Research"
      subtitle="2023-7-3 ~ 2023-8-27 at Institute of Precision Health, BGI Research/Shenzhen BGI Institute of Life Sciences, Shenzhen, China"
    >
      Multi-Omics Cohort Study of Cardiovascular and Cerebrovascular Diseases, with hands-on practice on HPC(High-Performance Computing)
    </TimeLineElement>
  </div>

  <div class="mb-5">
    <div class="text-3xl w-full font-bold">Publications</div>
  </div>

  <ul class="list-disc mx-6 mb-10 grid gap-2">
    <li>
      <a href="https://doi.org/10.xxxx/xxxxx" target="_blank">Author A, <b>Dow J.H.</b>, et al. (2026). Paper
   title. <i>Journal</i>.</a>
    </li>
  </ul>

  <div class="mb-5">
    <div class="text-3xl w-full font-bold">Skills</div>
  </div>

  <div class="grid gap-6 mb-10">                                                                                                               
    <div>                                                                                                                                      
      <h3 class="text-xl font-semibold mb-2">Coding</h3>                                                                                  
      <div class="flex flex-wrap gap-2">                                                                                                       
        <span class="badge badge-outline">Python</span>                                                                                        
        <span class="badge badge-outline">R</span>                                                                                       
        <span class="badge badge-outline">Bash/Shell</span> 
        <span class="badge badge-outline">Linux</span>                                                                                                                                                                            
      </div>                                                                                                                                   
    </div>  
    
    <div>                                                                                                                                      
      <h3 class="text-xl font-semibold mb-2">Machine Learning</h3>                                                                                  
      <div class="flex flex-wrap gap-2">                                                                                                       
        <span class="badge badge-outline">Scikit-learn</span>                                                                                        
        <span class="badge badge-outline">Pytorch</span>                                                                                                                                                                                                                                                                
      </div>                                                                                                                                   
    </div>  

    <div>                                                                                                                                      
      <h3 class="text-xl font-semibold mb-2">Molecular Dynamics Simulation</h3>                                                                                  
      <div class="flex flex-wrap gap-2">                                                                                                       
        <span class="badge badge-outline">Gromacs</span>                                                                                        
        <span class="badge badge-outline">Amber/Ambertools</span>                                                                                                                                                                                                                                                                
      </div>                                                                                                                                   
    </div> 

    <div>                                                                                                                                      
      <h3 class="text-xl font-semibold mb-2">Electronics & Mechanical CAD / Simulation</h3>                                                                                  
      <div class="flex flex-wrap gap-2">                                                                                                       
        <span class="badge badge-outline">Multisim</span>                                                                                        
        <span class="badge badge-outline">Quartus</span>           
        <span class="badge badge-outline">SolidWorks</span> 
        <span class="badge badge-outline">MATLAB</span>                                                                                                                                                                                                                                                          
      </div>                                                                                                                                   
    </div> 

    <div>                                                                                                                                      
      <h3 class="text-xl font-semibold mb-2">Multi-Omics Pipeline Analysis</h3>                                                                                  
      <div class="flex flex-wrap gap-2">                                                                                                       
        <span class="badge badge-outline">Bulk Multi-Omics</span>                                                                                        
        <span class="badge badge-outline">Single-Cell Multi-Omics</span>           
        <span class="badge badge-outline">Spatial Transcriptomics/Spatial Omics</span>                                                                                                                                                                                                                                                     
      </div>                                                                                                                                   
    </div> 
  </div>

  <div class="mb-5">                                                                                         
    <div class="text-3xl w-full font-bold">Awards</div>                                                      
  </div>                                                                                                     
  <ul class="list-disc mx-6 mb-10 grid gap-2">                                                               
    <li>2024 · Outstanding Undergraduate Graduate of Southeast University</li>                                                                               
  </ul>  


</BaseLayout>
