---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getBeyondEntries } from "../../lib/beyondEntries";

// 列表标题 = 文件名（不含扩展名）。改标题 = 重命名 md 文件。
const entries = await getBeyondEntries();
---

<BaseLayout title="Beyond" sideBarActiveItemID="beyond">
  <div class="beyond-index">
    {/* 通栏 hero。两个负边距都是在抵消 main 自己的内边距（p-6 / pt-10），
        这样它铺满内容区并贴顶，而不会像 100vw 那样伸到侧边栏底下、
        也不会在窄屏多出横向滚动条。背景图换成自己的：
        覆盖 public/beyond/bg.webp 即可，代码不用动（底下垫了渐变，图丢了也不难看）。 */}
    <div
      class="-mx-6 -mt-10 flex items-center justify-center bg-cover bg-center px-6 py-24 lg:py-32"
      style="background-image: linear-gradient(to top, rgba(8, 12, 18, 0.86), rgba(8, 12, 18, 0.5) 55%, rgba(8, 12, 18, 0.3)), url('/beyond/bg.webp')"
    >
      <div class="text-center text-white">
        <h1 class="text-4xl font-bold tracking-tight lg:text-5xl">Beyond the Bench</h1>
        <p class="mt-4 text-base text-white/75 lg:text-lg">工作之外的一些记录</p>
      </div>
    </div>

    <div class="mx-auto mt-12 max-w-[900px]">
      <div class="flex items-baseline justify-between">
        <h2 class="text-2xl font-bold">Entries</h2>
        <span class="text-sm text-base-content/45">{entries.length} 个条目</span>
      </div>

      {
        entries.length === 0 ? (
          <p class="mt-6 text-base-content/60">
            还没有内容。在 src/content/beyond/ 放 .md 文件即可。
          </p>
        ) : (
          <ol class="mt-2 divide-y divide-base-300 border-t border-base-300">
            {entries.map((entry, i) => (
              <li>
                <a
                  href={`/beyond/${entry.slug}`}
                  class="group -mx-3 flex items-center gap-4 rounded-lg px-3 py-5 transition ease-in-out hover:bg-base-200"
                >
                  <span class="w-7 shrink-0 font-mono text-sm tabular-nums text-base-content/35">
                    {String(i + 1).padStart(2, "0")}
                  </span>
                  <span class="text-xl font-bold transition-transform group-hover:translate-x-1">
                    {entry.title}
                  </span>
                  <span class="ml-auto text-lg text-base-content/30 transition group-hover:translate-x-1 group-hover:text-base-content/70">
                    →
                  </span>
                </a>
              </li>
            ))}
          </ol>
        )
      }
    </div>
  </div>
</BaseLayout>
