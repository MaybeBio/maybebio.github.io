---
import BaseLayout from "../layouts/BaseLayout.astro";
import HorizontalCard from "../components/HorizontalCard.astro";
import { getCollection } from "astro:content";
import createSlug from "../lib/createSlug"
import { categoryLabel } from "../config";

const posts = (await getCollection("blog")).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const last_posts = posts.slice(0, 3);
---

<BaseLayout sideBarActiveItemID="home">
  <div class="pb-12 mt-5">
    <div class="text-xl py-1">Hey there 👋</div>
    <div class="text-5xl font-bold">I'm Joe Hoye Dow</div>
    <div class="text-3xl py-3 font-bold">Computational Biology / Bioinformatics</div>
    <div class="py-2 text-lg">   
        <div>A Computational Biology PhD Candidate at Shanghai Jiao Tong University.</div> 
        <div class="mt-2">I’m currently working on ensemble conformational dynamics of Intrinsically Disordered Regions (IDRs) of proteins —— especially those transcription factors associated with the 3D genome —— by combining deep learning modeling and molecular dynamics simulations.</div>
    </div>
    <div class="mt-8">
      <a class="btn" href="https://github.com/MaybeBio" target="_blank"> Let's connect!</a>
    </div>
  </div>

  <div>
    <div class="text-3xl w-full font-bold mb-2">Selected Projects</div>
  </div>

  <HorizontalCard
    title="pyPaperFlow"
    img="/proj_paperflow.webp"
    desc="An automated literature processing platform for scientific researchers. Batch retrieve, fetch, parse, and structure papers from PubMed, arXiv, bioRxiv, ChemRxiv, and DOI-based sources. From paper retrieval to knowledge internalization, automate the heavy lifting and keep the judgment human."
    url="https://maybebio.github.io/pyPaperFlow/"
    badge="Paper reading"
  />
  <div class="divider my-0"></div>
  <HorizontalCard
    title="Repowiki-cli"
    img="/proj_repowiki.webp"
    desc="Query AI-generated documentation for any public GitHub repository — straight from your terminal. Including three wiki services: DeepWiki · Google Code Wiki · zread.ai."
    url="https://github.com/MaybeBio/Repowiki-cli"
    badge="GitHub coding"
  />
  <div class="divider my-0"></div>
  <HorizontalCard
    title="Gromacs-Everything-Skill"
    img="/proj_gromacs.webp"
    desc="Claude Code skill for Gromacs，designed for Molecular Dynamics Simulation Operation & QA."
    url="https://github.com/MaybeBio/Gromacs-Everything-Skill"
    badge="Claude Code skill for Gromacs"
  />

  <div>
    <div class="text-3xl w-full font-bold mb-5 mt-10">Latest from blog</div>
  </div>

  {
    last_posts.map((post) => (
      <>
        <HorizontalCard
          title={post.data.title}
          img={post.data.heroImage}
          desc={post.data.description}
          url={"/blog/" + createSlug(post.data.title, post.slug)}
          target="_self"
          badge={post.data.badge}
          category={categoryLabel(post.data.category)}
        />
        <div class="divider my-0" />
      </>
    ))
  }
</BaseLayout>
