---
import BaseLayout from "../layouts/BaseLayout.astro";
import HorizontalCard from "../components/HorizontalCard.astro";
---

<BaseLayout title = "Projects" sideBarActiveItemID="projects">

  <div>
    <div class="text-3xl w-full font-bold mb-5">Protein structure + AI</div>
  </div>

  <HorizontalCard
    title="AlphaFold3-SeqVisToolkit"
    img="/proj_af3.webp"
    desc="A lightweight toolkit for visualizing and analyzing AlphaFold3 prediction outputs."
    url="https://github.com/MaybeBio/AlphaFold3-SeqVisToolkit"
    badge="AlphaFold3"
  />
  <div class="divider my-0"></div>
  <HorizontalCard
    title="Awesome-IDR-Prediction"
    img="/proj_idr.webp"
    desc="Curated Labs, Tools for Protein Intrinsic Disorder (IDR) prediction."
    url="https://github.com/MaybeBio/Awesome-IDR-Prediction"
    badge="Protein Disorder Prediction"
  />
  <div class="divider my-0"></div>
  <HorizontalCard
    title="Awesome-Protein-ContactMap-Prediction"
    img="/proj_ppi.webp"
    desc="A curated collection of computational tools for intermolecular interaction prediction, primarily focus on Protein Interface Contact Prediction task."
    url="https://github.com/MaybeBio/Awesome-Protein-ContactMap-Prediction"
    badge="PPI Interface prediction"
  />
  <div class="divider my-0"></div>
  <HorizontalCard
    title="IDRInter_seq"
    img="/proj_idrinter-seq.webp"
    desc="A Transformer model: binary classification task takes two protein sequences (one IDP with IDR and one ordered protein) and their target segment coordinates as inputs, to predict whether physical contact occurs between the fragments at the segment level. The output is a binary label (0/1) or raw logits for interaction probability."
    url="https://github.com/MaybeBio/IDRInter_seq"
    badge="Transformer"
  />


  <div>
    <div class="text-3xl w-full font-bold mb-5">Molecular Dynamic Simulation</div>
  </div>

  <HorizontalCard
    title="Gromacs-Everything-Skill"
    img="/proj_gromacs.webp"
    desc="Claude Code skill for Gromacs，designed for Molecular Dynamics Simulation Operation & QA."
    url="https://github.com/MaybeBio/Gromacs-Everything-Skill"
    badge="Claude Code skill for Gromacs"
  />
  <div class="divider my-0"></div>
  <HorizontalCard
    title="AmberTools-Everything-Skill"
    img="/proj_amber.webp"
    desc="Claude code skill for AmberTools，designed for molecular dynamics simulation operation & QA."
    url="https://github.com/MaybeBio/AmberTools-Everything-Skill"
    badge="Claude Code skill for Amber/AmberTools"
  />
  <div class="divider my-0"></div>
  <HorizontalCard
    title="gmxplot"
    img="/proj_gmxplot.webp"
    desc="GROMACS XVG File Visualization Tool. Auto-detect, plot, compare, and summarize your GROMACS simulation data from the command line."
    url="https://github.com/MaybeBio/gmxplot"
    badge="Gromacs Visualization"
  />
  <div class="divider my-0"></div>
  <HorizontalCard
    title="PDB-MD-Suite"
    img="/proj_md.webp"
    desc="Pre- and post-processing toolkit for PDB/MMCIF structure files in molecular dynamics workflows."
    url="https://github.com/MaybeBio/PDB-MD-Suite"
    badge="Molecular dynamic workflows"
  />

  <div>
    <div class="text-3xl w-full font-bold mb-5">Machine Learning</div>
  </div>

  <HorizontalCard
    title="AI4Bio-LHT"
    img="/proj_lht.webp"
    desc="A clean template to kickstart your deep learning project. Modified to focus on AI4Bio field. "
    url="https://github.com/MaybeBio/AI4Bio-LHT"
    badge="LHT template"
  />
  <div class="divider my-0"></div>
  <HorizontalCard
    title="Sklearn-Skill"
    img="/proj_sklearn.webp"
    desc="Claude Code skill for Scikit-Learn，designed for machine learning Coding operation & QA."
    url="https://github.com/MaybeBio/Sklearn-Skill"
    badge="Claude Code skill for Scikit-Learn"
  />
  <div class="divider my-0"></div>
  <HorizontalCard
    title="Pytorch-Skill"
    img="/proj_pytorch.webp"
    desc="Claude code skill for pytorch code writing."
    url="https://github.com/MaybeBio/Pytorch-Skill"
    badge="Claude Code skill for Pytorch"
  />
  <div class="divider my-0"></div>
  <HorizontalCard
    title="Pytorch-Template-Skill"
    img="/proj_pytorch_eco.webp"
    desc="Lightning-Hydra-Template · PyTorch Lightning 2.5.5 · Hydra 1.4 · HuggingFace Ecosystem · Optuna · Visualization & Interpretability. This repository distills the Lightning-Hydra-Template plus the official documentation and example code of the surrounding deep-learning ecosystem into a unified Claude Code Skill — a structured knowledge base covering the full ML engineering stack from project scaffolding to model training, hyperparameter optimization, experiment tracking, and interpretability."
    url="https://github.com/MaybeBio/Pytorch-Template-Skill"
    badge="Claude Code skill for pytorch ecosystem"
  />

  <div>
    <div class="text-3xl w-full font-bold mb-5">Research tools</div>
  </div>

  <HorizontalCard
    title="pyPaperFlow"
    img="/proj_paperflow.webp"
    desc="An automated literature processing platform for scientific researchers. Batch retrieve, fetch, parse, and structure papers from PubMed, arXiv, bioRxiv, ChemRxiv, and DOI-based sources. From paper retrieval to knowledge internalization, automate the heavy lifting and keep the judgment human."
    url="https://maybebio.github.io/pyPaperFlow/"
    badge="Paper reading"
  />
  <div class="divider my-0"></div>
  <HorizontalCard
    title="Repowiki-cli"
    img="/proj_repowiki.webp"
    desc="Query AI-generated documentation for any public GitHub repository — straight from your terminal. Including three wiki services: DeepWiki · Google Code Wiki · zread.ai."
    url="https://github.com/MaybeBio/Repowiki-cli"
    badge="GitHub coding"
  />
  <div class="divider my-0"></div>
  <HorizontalCard
    title="GhResearcher"
    img="/proj_gh.webp"
    desc="A powerful GitHub Code & Repo Analysis CLI for Researchers, designed to track activities, scrape and parse repository contexts, and search intelligently—without leaving YOUR terminal."
    url="https://github.com/MaybeBio/GhResearcher"
    badge="GitHub trending"
  />
  <div class="divider my-0"></div>
  <HorizontalCard
    title="LibInspector"
    img="/proj_pylib.webp"
    desc="From 'Black Box' to 'Glass Box': A Python library inspection tool. Turn passive code reading into active architectural exploration."
    url="https://github.com/MaybeBio/LibInspector"
    badge="Python AST analysis"
  />
  <div class="divider my-0"></div>
  <HorizontalCard
    title="Repo-Inspector"
    img="/proj_pyrepo.webp"
    desc="Repo-Inspector helps developers and reviewers quickly understand a Python repository. It produces a concise static analysis report and — optionally — deeper runtime inspection output by integrating with LibInspector."
    url="https://github.com/MaybeBio/Repo-Inspector"
    badge="Python repository analysis"
  />

  <div>
    <div class="text-3xl w-full font-bold mb-5 mt-10">Research Automation</div>
  </div>

  <HorizontalCard
    title="Daily-GitHub-AI4Bio"
    img="/proj_daily_github.webp"
    desc="A template to capture GitHub academic community activity for protein structural AI. It centralizes fragmented research signals, delivering a readable timeline for tracking field developments and discovering emerging trends."
    url="https://github.com/MaybeBio/Daily-GitHub-AI4Bio"
    badge="GitHub Trending Automation"
  />
  <div class="divider my-0"></div>
  <HorizontalCard
    title="Daily-Paper-Agent-Template"
    img="/proj_paper_agent.webp"
    desc="Biomedical × Computational Interdisciplinary Literature Auto-Tracking + AI Deep Reading Template. Automatically track the latest papers on PubMed · arXiv · bioRxiv · medRxiv · chemRxiv periodically via GitHub Actions, archive the documents and generate weekly Issue reports. An LLM produces a “score + one-sentence summary + abstract translation + 16-section Paper Card + reviewer evaluation” for each paper. A fully searchable GitHub Pages site is deployed, and Zotero is integrated for literature screening and library import."
    url="https://github.com/MaybeBio/Daily-Paper-Agent-Template"
    badge="Paper Automation with AI"
  />
  <div class="divider my-0"></div>
  <HorizontalCard
    title="Daily-Paper-noAgent-Template"
    img="/proj_paper.webp"
    desc="Automated Literature Alert Template for Biomedical and Computational Interdisciplinary Research. Automatically track the latest papers on PubMed · arXiv · bioRxiv · medRxiv · chemRxiv periodically via GitHub Actions, save duplicates, generate weekly Issue reports, and leverage Zotero and AI tools for screening and intensive reading."
    url="https://github.com/MaybeBio/Daily-Paper-noAgent-Template"
    badge="Paper Automation"
  />
</BaseLayout>
